id","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"af","roundness":null,"seed":4301808,"version":3,"versionNonce":42,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"WHY ITS TOTAL DIFFERS","fontSize":18,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":"label-why","originalText":"WHY ITS TOTAL DIFFERS","autoResize":true,"lineHeight":1.25},{"id":"Yx6lDqkhgZDiov7XfdWga","type":"text","x":39,"y":719,"width":79.199951171875,"height":22.5,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ag","roundness":null,"seed":4406537,"version":3,"versionNonce":43,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"EVIDENCE","fontSize":18,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":"label-evidence","originalText":"EVIDENCE","autoResize":true,"lineHeight":1.25},{"id":"PlH2Mv20arJutgNoE9nnx","type":"text","x":39,"y":233,"width":354.789794921875,"height":78.19999999999999,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ah","roundness":null,"seed":4511266,"version":3,"versionNonce":44,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Per-field, uncorrected t,\nthe control","fontSize":34,"fontFamily":7,"textAlign":"left","verticalAlign":"top","containerId":"head-0","originalText":"Per-field, uncorrected t, the control","autoResize":true,"lineHeight":1.15},{"id":"U8raQ6DaqBXhQkJUjJpF1","type":"text","x":39,"y":366,"width":356.7297058105469,"height":310.5,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ai","roundness":null,"seed":4615995,"version":3,"versionNonce":45,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"At guidance 2 the asks blur\ntogether: neighbouring asks draw\nthe same training line-ups, so one\nline-up is counted at many asks.\nStronger guidance pins each line-\nup to a few asks. The low asks\nthen fill with novel line-ups that\nare drawn at one ask only, and the\nhigh asks narrow onto a few\ntraining line-ups","fontSize":23,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"stand-0","originalText":"At guidance 2 the asks blur together: neighbouring asks draw the same training line-ups, so one line-up is counted at many asks. Stronger guidance pins each line-up to a few asks. The low asks then fill with novel line-ups that are drawn at one ask only, and the high asks narrow onto a few training line-ups","autoResize":true,"lineHeight":1.35},{"id":"QqpyxZneMDvQpdpWSVLGp","type":"text","x":39,"y":753,"width":349.8087463378906,"height":102.60000000000001,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aj","roundness":null,"seed":4720724,"version":3,"versionNonce":46,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"2,216 of the 2,329 repeats at guidance 2\nare a line-up drawn at the next ask too,\nand 45 of the 50 most widespread line-\nups are training line-ups","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-0","originalText":"2,216 of the 2,329 repeats at guidance 2 are a line-up drawn at the next ask too, and 45 of the 50 most widespread line-ups are training line-ups","autoResize":true,"lineHeight":1.35},{"id":"Jbc14RxEa-JOGlH_wI97x","type":"text","x":39,"y":875,"width":351.80377197265625,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ak","roundness":null,"seed":4825453,"version":3,"versionNonce":47,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"The 20 most widespread take 239 ask\nslots at guidance 2, 96 at guidance 4 and\n34 at guidance 8","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-1","originalText":"The 20 most widespread take 239 ask slots at guidance 2, 96 at guidance 4 and 34 at guidance 8","autoResize":true,"lineHeight":1.35},{"id":"jUYmOikSODpaUHaSdhzsS","type":"text","x":39,"y":971,"width":348.3457946777344,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"al","roundness":null,"seed":4930182,"version":3,"versionNonce":48,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Novel line-ups go from 502 to 834 to\n1,236, and 1,130 of the 1,236 are drawn\nat one ask","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-2","originalText":"Novel line-ups go from 502 to 834 to 1,236, and 1,130 of the 1,236 are drawn at one ask","autoResize":true,"lineHeight":1.35},{"id":"3iPLsrADUQ6O0z3VncSt_","type":"text","x":39,"y":1067,"width":333.0697937011719,"height":25.650000000000002,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"am","roundness":null,"seed":5034911,"version":3,"versionNonce":49,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Training line-ups go from 1,011 to 890","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-3","originalText":"Training line-ups go from 1,011 to 890","autoResize":true,"lineHeight":1.35},{"id":"vXo4s0eooPF74XDPMXmm3","type":"text","x":39,"y":1112,"width":349.16278076171875,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"an","roundness":null,"seed":5139640,"version":3,"versionNonce":50,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"At ask 21 the count falls from 151 to 58\nand the most common line-up goes from\n6 teams to 35","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-4","originalText":"At ask 21 the count falls from 151 to 58 and the most common line-up goes from 6 teams to 35","autoResize":true,"lineHeight":1.35},{"id":"zFUFxzZG5vl9NFPAzucXn","type":"text","x":450,"y":233,"width":294.5078430175781,"height":39.099999999999994,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ao","roundness":null,"seed":5244369,"version":3,"versionNonce":51,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Linear, species-first","fontSize":34,"fontFamily":7,"textAlign":"left","verticalAlign":"top","containerId":"head-1","originalText":"Linear, species-first","autoResize":true,"lineHeight":1.15},{"id":"v6mboO2ZWTju6jcSXxlG2","type":"text","x":450,"y":366,"width":356.59173583984375,"height":155.25,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ap","roundness":null,"seed":5349098,"version":3,"versionNonce":52,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"The same thing happens, on many\nof the same line-ups. Its gap to\nthe control is small and mostly\ninside the spread between\nsampling seeds","fontSize":23,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"stand-1","originalText":"The same thing happens, on many of the same line-ups. Its gap to the control is small and mostly inside the spread between sampling seeds","autoResize":true,"lineHeight":1.35},{"id":"YjOEOw7T7LAOiQ19Fyvhc","type":"text","x":450,"y":753,"width":307.5718078613281,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aq","roundness":null,"seed":5453827,"version":3,"versionNonce":53,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"The two rows share 776 line-ups at\nguidance 2","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-0","originalText":"The two rows share 776 line-ups at guidance 2","autoResize":true,"lineHeight":1.35},{"id":"8LW1SbhmpZKeVK7nSm2wk","type":"text","x":450,"y":824,"width":342.30377197265625,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ar","roundness":null,"seed":5558556,"version":3,"versionNonce":54,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"The gap of +65 at guidance 2 is +48, +6\nand +25 by sampling seed","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-1","originalText":"The gap of +65 at guidance 2 is +48, +6 and +25 by sampling seed","autoResize":true,"lineHeight":1.35},{"id":"mX7PE8kL-v8t8BV3tpQUv","type":"text","x":450,"y":895,"width":330.90380859375,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"as","roundness":null,"seed":5663285,"version":3,"versionNonce":55,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"The gap of −66 at guidance 8 is −2, +2\nand +20 by seed, so it is noise","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-2","originalText":"The gap of −66 at guidance 8 is −2, +2 and +20 by seed, so it is noise","autoResize":true,"lineHeight":1.35},{"id":"D8Z_9qSg5qcKNxlLVcK4s","type":"text","x":450,"y":966,"width":353.51373291015625,"height":128.25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"at","roundness":null,"seed":5768014,"version":3,"versionNonce":56,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"One difference stands out: at asks 15/24\nto 23/24 under guidance 8 the control\nholds 226 line-ups, 93% of its teams on\ntraining line-ups, and this row holds 345,\nwith 77%","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-3","originalText":"One difference stands out: at asks 15/24 to 23/24 under guidance 8 the control holds 226 line-ups, 93% of its teams on training line-ups, and this row holds 345, with 77%","autoResize":true,"lineHeight":1.35},{"id":"U5T9NiqcW2YIdvL3SBrOX","type":"text","x":861,"y":233,"width":306.8498229980469,"height":39.099999999999994,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"au","roundness":null,"seed":5872743,"version":3,"versionNonce":57,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Linear, random order","fontSize":34,"fontFamily":7,"textAlign":"left","verticalAlign":"top","containerId":"head-2","originalText":"Linear, random order","autoResize":true,"lineHeight":1.15},{"id":"q9lBdjVFNQSyRrnlA_d7W","type":"text","x":861,"y":366,"width":350.93377685546875,"height":248.4,"angle":0,"strokeColor":"#e8590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"av","roundness":null,"seed":5977472,"version":3,"versionNonce":58,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"It is the same model as Linear,\nspecies-first, but it rarely puts a\ntraining team's six species\ntogether, so almost every team in\nan ask has its own line-up. Its\ntotal rises with guidance only\nbecause the few repeats between\nasks disappear","fontSize":23,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"stand-2","originalText":"It is the same model as Linear, species-first, but it rarely puts a training team's six species together, so almost every team in an ask has its own line-up. Its total rises with guidance only because the few repeats between asks disappear","autoResize":true,"lineHeight":1.35},{"id":"dHz-PShiuCHOdFtdNrPNu","type":"text","x":861,"y":753,"width":343.29180908203125,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"aw","roundness":null,"seed":6082201,"version":3,"versionNonce":59,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"12% of its teams have a training line-up\nat guidance 2, against 82% for species-\nfirst","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-2-0","originalText":"12% of its teams have a training line-up at guidance 2, against 82% for species-first","autoResize":true,"lineHeight":1.35},{"id":"HIObiOY8SffOlZJ0MdTaU","type":"text","x":861,"y":849,"width":319.7318115234375,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ax","roundness":null,"seed":6186930,"version":3,"versionNonce":60,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Its 10 most used species take 43% of\nspecies slots, against 64%","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-2-1","originalText":"Its 10 most used species take 43% of species slots, against 64%","autoResize":true,"lineHeight":1.35},{"id":"tkmGZfq-ctkJK4Ly-tnsM","type":"text","x":861,"y":920,"width":350.26483154296875,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ay","roundness":null,"seed":6291659,"version":3,"versionNonce":61,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"It draws 58 species that appear nowhere\nin the training table, in 24% of its teams,\nand species-first draws none","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-2-2","originalText":"It draws 58 species that appear nowhere in the training table, in 24% of its teams, and species-first draws none","autoResize":true,"lineHeight":1.35},{"id":"OQOx7u-0SUJZyRMon7ls9","type":"text","x":861,"y":1016,"width":354.0458068847656,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"az","roundness":null,"seed":6396388,"version":3,"versionNonce":62,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Repeats fall from 1,762 to 578, and most\nof the lost repeats are novel line-ups:\n1,486 to 479","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-2-3","originalText":"Repeats fall from 1,762 to 578, and most of the lost repeats are novel line-ups: 1,486 to 479","autoResize":true,"lineHeight":1.35},{"id":"nRCMKYch74DEOL-U715CC","type":"text","x":861,"y":1112,"width":332.9937744140625,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b00","roundness":null,"seed":6501117,"version":3,"versionNonce":63,"isDeleted":false,"boundElements":null,"updated":1794662603532,"link":null,"locked":false,"text":"Teams with a novel line-up win 0.236,\nagainst 0.323 for teams with a training\nline-up","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-2-4","originalText":"Teams with a novel line-up win 0.236, against 0.323 for teams with a training line-up","autoResize":true,"lineHeight":1.35}],"appState":{"viewBackgroundColor":"#ffffff","gridSize":null},"files":{}}