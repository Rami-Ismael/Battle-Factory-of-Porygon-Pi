t":1.35},{"id":"dVYBNnCbyDcdeI-Nsi5gg","type":"text","x":450,"y":233,"width":294.5078430175781,"height":39.099999999999994,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b06","roundness":null,"seed":7129491,"version":3,"versionNonce":69,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"Linear, species-first","fontSize":34,"fontFamily":7,"textAlign":"left","verticalAlign":"top","containerId":"head-1","originalText":"Linear, species-first","autoResize":true,"lineHeight":1.15},{"id":"dIeowCYlwEyVdQ9tc9Xja","type":"text","x":450,"y":366,"width":355.69476318359375,"height":310.5,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b07","roundness":null,"seed":7234220,"version":3,"versionNonce":70,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"Its asks share line-ups the same\nway, and many of them are the\ncontrol's line-ups. Its line-up total\ndiffers from the control's by +65,\n+53 and −66 at guidance 2, 4 and\n8. At guidance 8 the gap is inside\nthe control's seed-to-seed spread.\nAt guidance 2 every seed of this\nrow is above every seed of the\ncontrol","fontSize":23,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"stand-1","originalText":"Its asks share line-ups the same way, and many of them are the control's line-ups. Its line-up total differs from the control's by +65, +53 and −66 at guidance 2, 4 and 8. At guidance 8 the gap is inside the control's seed-to-seed spread. At guidance 2 every seed of this row is above every seed of the control","autoResize":true,"lineHeight":1.35},{"id":"wo5YDPZC98HzAtbipdpIU","type":"text","x":450,"y":877,"width":307.5718078613281,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b08","roundness":null,"seed":7338949,"version":3,"versionNonce":71,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"The two rows share 776 line-ups at\nguidance 2","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-0","originalText":"The two rows share 776 line-ups at guidance 2","autoResize":true,"lineHeight":1.35},{"id":"dLHkECO6bP8GEMUZXOIwT","type":"text","x":450,"y":948,"width":334.55181884765625,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b09","roundness":null,"seed":7443678,"version":3,"versionNonce":72,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"At guidance 2 the control's seeds have\n525, 543 and 534 line-ups, a spread of\n18","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-1-1","originalText":"At guidance 2 the control's seeds have 525, 543 and 534 line-ups, a spread of 18","autoResize":true,"lineHeight":1.35},{"id":"XLg34LpxGI4rKmuyaKLXm","type":"text","x":450,"y":1044,"width":352.3358154296875,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0A","roundness":null,"seed":7548407,"version":3,"versionNonce":73,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"This row's seeds have 573, 549 and 559,\ngaps of +48, +6 and +25","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","con