ON6p","type":"text","x":39,"y":877,"width":357.78875732421875,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"ay","roundness":null,"seed":6291659,"version":3,"versionNonce":61,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"At guidance 2, 2,216 of the 2,329 repeats\nalso appear at the neighbouring ask","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-0","originalText":"At guidance 2, 2,216 of the 2,329 repeats also appear at the neighbouring ask","autoResize":true,"lineHeight":1.35},{"id":"EHIl3PcR011nmywdyZpWK","type":"text","x":39,"y":948,"width":356.1357727050781,"height":51.300000000000004,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"az","roundness":null,"seed":6396388,"version":3,"versionNonce":62,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"45 of the 50 most widespread line-ups at\nguidance 2 are training line-ups","fontSize":19,"fontFamily":6,"textAlign":"left","verticalAlign":"top","containerId":"body-0-1","originalText":"45 of the 50 most widespread line-ups at guidance 2 are training line-ups","autoResize":true,"lineHeight":1.35},{"id":"zCdTFQdvlEGAFw3r61JEe","type":"text","x":39,"y":1019,"width":358.5107727050781,"height":76.95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b00","roundness":null,"seed":6501117,"version":3,"versionNonce":63,"isDeleted":false,"boundElements":null,"updated":1794684246720,"link":null,"locked":false,"text":"The 20 most widespread at g