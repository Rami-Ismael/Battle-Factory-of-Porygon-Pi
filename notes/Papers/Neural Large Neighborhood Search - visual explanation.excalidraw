      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Apply an operator pair across different instances in parallel.\nAccept a repaired candidate only if it improves its current solution.\nChoose pairs using a moving average of previous improvements.\nTraining is separate from this adaptation of operator choice.\nThese two modes do not use the same acceptance strategy.",
      "originalText": "Apply an operator pair across different instances in parallel.\nAccept a repaired candidate only if it improves its current solution.\nChoose pairs using a moving average of previous improvements.\nTraining is separate from this adaptation of operator choice.\nThese two modes do not use the same acceptance strategy.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
