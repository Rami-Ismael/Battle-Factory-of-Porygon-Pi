    },
    {
      "id": "nln00125",
      "type": "text",
      "x": 65,
      "y": 2330,
      "width": 1250.0,
      "height": 86.25,
      "angle": 0,
      "strokeColor": "#203249",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
