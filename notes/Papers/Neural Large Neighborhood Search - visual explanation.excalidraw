      "fontSize": 25,
      "fontFamily": 2,
      "text": "Existing team -> choose sets to replace -> conditional generator fills them -> battle evaluation -> keep / explore",
      "originalText": "Existing team -> choose sets to replace -> conditional generator fills them -> battle evaluation -> keep / explore",
      "textAlign": "left",
      "verticalAlign": "top",
