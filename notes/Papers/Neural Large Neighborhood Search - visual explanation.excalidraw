      "fontSize": 23,
      "fontFamily": 2,
      "text": "Each customer has a demand; each vehicle has capacity Q.\nEvery route starts and ends at the depot; visit each customer once.\nMinimize total travel distance while keeping every route load <= Q.",
      "originalText": "Each customer has a demand; each vehicle has capacity Q.\nEvery route starts and ends at the depot; visit each customer once.\nMinimize total travel distance while keeping every route load <= Q.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
