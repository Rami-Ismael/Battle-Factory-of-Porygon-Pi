      "boundElements": null,
      "updated": 1788880000000,
      "link": null,
      "locked": false,
      "fontSize": 23,
      "fontFamily": 2,
      "text": "The transferable idea is a learned repair operator inside an iterative search. Your diffusion model could play that role.\nKeeping 3-5 sets and regenerating the others would define a neighborhood around an existing team.\nThis is a proposed adaptation: the paper uses routing-specific actions and exact distance costs, not noisy battle win rates.",
      "originalText": "The transferable idea is a learned repair operator inside an iterative search. Your diffusion model could play that role.\nKeeping 3-5 sets and regenerating the others would define a neighborhood around an existing team.\nThis is a proposed adaptation: the paper uses routing-specific actions and exact distance costs, not noisy battle win rates.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nln00126",
      "type": "text",
      "x": 52,
      "y": 2456,
      "width": 1198.5,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#203249",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 8946,
      "version": 1,
      "versionNonce": 14238,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788880000000,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Evidence boundary: the paper reports better results than its handcrafted-repair LNS baseline and competitive routing results.",
      "originalText": "Evidence boundary: the paper reports better results than its handcrafted-repair LNS baseline and competitive routing results.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nln00127",
