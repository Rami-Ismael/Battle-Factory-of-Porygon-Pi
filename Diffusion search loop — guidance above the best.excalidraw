  {
   "id": "e039",
   "type": "text",
   "x": 1658,
   "y": 482,
   "width": 411.6,
   "height": 187.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
